# --- Server ---
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
# SQLite file, created on first run
DATABASE_PATH=./var/kaziscout.sqlite

# --- Access ---
# Leave empty when KaziScout only listens on this computer (HOST=127.0.0.1).
# Required, 16+ characters, before it will listen on any other address. Browsers sign in with
# it; scripts and agents send it as "Authorization: Bearer <token>".
ACCESS_TOKEN=

# --- Scheduled scans and alerts ---
# Minutes between automatic scans while the server runs. 0 is off; the minimum is 15.
SCAN_INTERVAL_MINUTES=0
# Optional. After each scheduled scan, new jobs scoring at or above ALERT_MIN_SCORE are posted
# here as JSON. Works with Slack, Discord, ntfy, Zapier, n8n and similar webhook receivers.
ALERT_WEBHOOK_URL=
ALERT_MIN_SCORE=4

# --- Page to Markdown ---
# Optional. With a key, pages are converted by Firecrawl (https://firecrawl.dev).
# Without one, KaziScout uses its built-in local converter.
FIRECRAWL_API_KEY=

# --- AI assessment (optional; any model) ---
# Without this, KaziScout uses its built-in offline scorer.
#
# Option A: any OpenAI-compatible server. Set the base URL and the model name.
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek    AI_BASE_URL=https://api.deepseek.com/v1
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      AI_BASE_URL=http://localhost:11434/v1   (local and free; no key needed)
#   LM Studio   AI_BASE_URL=http://localhost:1234/v1    (local and free; no key needed)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
#
# Option B: Claude through the Anthropic API. Used when AI_BASE_URL is empty.
# AI_MODEL is optional here and defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=

# --- Desktop assistant ---
# Set to true to let KaziScout copy an application pack to your clipboard
# through computer-use-mcp. It never clicks Submit.
DESKTOP_ASSIST_ENABLED=false
