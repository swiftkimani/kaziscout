# --- Server ---
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
# SQLite file, created on first run
DATABASE_PATH=./var/kaziscout.sqlite

# --- Page to Markdown ---
# Optional. With a key, pages are converted by Firecrawl (https://firecrawl.dev).
# Without one, KaziScout uses its built-in local converter.
FIRECRAWL_API_KEY=

# --- AI evaluation ---
# Optional. With a key, "Evaluate with Claude" gives a written assessment.
# Without one, KaziScout uses its built-in offline scorer.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Desktop assistant ---
# Set to true to let KaziScout copy an application pack to your clipboard
# through computer-use-mcp. It never clicks Submit.
DESKTOP_ASSIST_ENABLED=false
